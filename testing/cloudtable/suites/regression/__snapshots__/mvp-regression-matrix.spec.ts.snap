          "title": "Q3 Renewal"
        },
        "hiddenFieldIds": [
          "salary"
        ],
        "redactedFieldIds": [
          "customer_note"
        ],
        "states": {
          "customer_note": "redacted",
          "internal_note": "visible",
          "salary": "hidden",
          "title": "visible"
        }
      },
      "workflowRead": {
        "diagnostics": [
          "workflow_hidden:salary",
          "field_read_only:salary",
          "workflow_redacted:customer_note",
          "workflow_hidden:internal_note"
        ],
        "fields": {
          "customer_note": "[redacted]",
          "title": "Q3 Renewal"
        },
        "hiddenFieldIds": [
          "salary",
          "internal_note"
        ],
        "redactedFieldIds": [
          "customer_note"
        ],
        "states": {
          "customer_note": "redacted",
          "internal_note": "hidden",
          "salary": "hidden",
          "title": "visible"
        }
      }
    },
