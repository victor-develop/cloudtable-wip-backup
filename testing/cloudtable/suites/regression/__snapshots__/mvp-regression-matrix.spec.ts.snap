  {
    "actual": {
      "directRead": {
        "diagnostics": [
          "field_hidden:salary",
          "field_read_only:salary",
          "field_redacted:customer_note"
        ],
        "fields": {
          "customer_note": "[redacted]",
          "internal_note": "Only humans should see this in workflow steps",
          "title": "Q3 Renewal"
        },
        "hiddenFieldIds": [
          "salary"
        ],
        "redactedFieldIds": [
          "customer_note"
        ],
        "states": {
          "customer_note": "redacted",
          "internal_note": "visible",
          "salary": "hidden",
          "title": "visible"
        }
      },
      "viewRead": {
        "diagnostics": [
          "field_hidden:salary",
          "field_read_only:salary",
          "field_redacted:customer_note"
        ],
        "fields": {
          "customer_note": "[redacted]",
